---
import Layout from '../../layouts/Layout.astro';
import { designers } from '../../data/designers';
import { collectionMedia } from '../../lib/content';
import { url } from '../../lib/paths';
import '../../styles/content.css';
---
<Layout title="Návrháři" active="navrhari" description="Tvůrci a kolekce ve fotografickém archivu Czech Fashion Week. Autorská móda, couture, pánské kolekce a resort fashion.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Rukopisy, které poznáte.</p><h1>Za každou siluetou<br />je autor.</h1><p class="section-intro">Objevte tvorbu prostřednictvím kolekcí a skutečných momentů z minulých ročníků Czech Fashion Week.</p></div></section>
  <section class="section container"><div class="designer-index">{designers.map(designer => {const image=collectionMedia(designer.collectionMatchers).find(m=>m.type==='photo');return <article class="designer-tile reveal"><a href={url(`navrhari/${designer.slug}/`)}><div class="image-frame">{image && <img src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="lazy" />}</div><h2>{designer.name}</h2><p class="designer-category">{designer.category}</p><p class="designer-years">V archivu / {designer.years.join(' · ')}</p></a><a class="text-link" href={url(`navrhari/${designer.slug}/`)}>Příběh kolekce <span aria-hidden="true">↗</span></a></article>})}</div><p class="source-note" style="margin-top:60px">Profily zachycují doloženou historickou účast. Potvrzené kolekce konkrétní nadcházející události uvádíme v jejím programu.</p></section>
</Layout>
