---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { designers } from '../../data/designers';
import { collectionMedia } from '../../lib/content';
import { url } from '../../lib/paths';
import '../../styles/content.css';
---
<Layout title="Návrháři" active="navrhari" description="Osobnosti a značky Czech Fashion Week. Profily návrhářů a kolekce z jednotlivých ročníků.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Rukopisy, které poznáte.</p><h1>Za každou siluetou<br />je autor.</h1><p class="section-intro">Poznejte osobnosti a značky Czech Fashion Week. Objevte jejich rukopis, kolekce a okamžiky z přehlídek.</p></div></section>
  <section class="section container">
    <div class="designer-index">
      {designers.map(designer => {
        const archiveImage = collectionMedia(designer.collectionMatchers).find(m => m.type === 'photo');
        const image = designer.portrait || archiveImage;
        return <article class="designer-tile reveal">
          <a href={url(`navrhari/${designer.slug}/`)}>
            <div class="image-frame" style={designer.portrait ? 'aspect-ratio:1' : undefined}>{image && <img src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="lazy" />}</div>
            <h2>{designer.name}</h2>
            <p class="designer-category">{designer.category}</p>
            <p class="designer-years">{designer.years.length ? `V archivu / ${designer.years.join(' · ')}` : 'Profil CFW'}</p>
            {!designer.portrait && <p class="image-caption">Archivní fotografie kolekce</p>}
          </a>
          <a class="text-link" href={url(`navrhari/${designer.slug}/`)}>Prohlédnout profil <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
        </article>;
      })}
    </div>
    <p class="source-note" style="margin-top:60px">Archivní kolekce mají uvedený vlastní ročník. Účast u nadcházejících událostí najdete v <a href={url('program/')}>programu konkrétní akce</a>.</p>
  </section>
</Layout>
