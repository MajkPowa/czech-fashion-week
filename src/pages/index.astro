---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
import media from '../data/media.json';
import { collectionMedia } from '../lib/content';
import '../styles/home.css';
const byOriginal = (name: string) => media.find(m => m.originalFilename.toLowerCase() === name.toLowerCase());
const hero = byOriginal('ZLY_8170.jpg') || media.find(m => m.year === 2024 && m.type === 'photo');
const mobileHero = byOriginal('ZLY_8251.jpg') || hero;
const klett = byOriginal('ZLY_8060.jpg') || hero;
const menswear = byOriginal('ZLY_7993.jpg') || hero;
const laffita = media.find(m => m.year === 2022 && m.collection?.toLowerCase().includes('osmany') && m.type === 'photo') || hero;
const hanak = collectionMedia(['Luděk Hanák']).find(m => m.year === 2024 && m.type === 'photo');
const backstage = media.find(m => m.year === 2020 && m.tags?.includes('backstage') && m.type === 'photo') || media.find(m => m.year === 2020 && m.type === 'photo') || hero;
const runwayVideo = media.find(m => m.type === 'video' && m.year === 2024 && m.originalFilename.toLowerCase() === 'iveta.mov' && m.collection?.toLowerCase().includes('klett')) || media.find(m => m.type === 'video' && m.year === 2024);
const archiveImages = [klett, menswear, hero].filter(Boolean);
---
<Layout title="Czech Fashion Week" description="Móda. Naživo. Objevte Czech Fashion Week, CFW Glamour Praha 20. listopadu 2026 a fotografický archiv českých přehlídek.">
  <section class="home-hero" aria-labelledby="hero-title">
    {hero && <picture><source media="(max-width: 760px)" srcset={url(mobileHero!.src)} /><img class="home-hero-image" src={url(hero.src)} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" loading="eager" /></picture>}
    <div class="container hero-content">
      <div class="hero-top"><p class="eyebrow">Czech Fashion Week</p><p class="hero-edition">ČESKÁ MÓDA<br />V ŽIVÉM OBRAZE</p></div>
      <div><h1 class="hero-headline" id="hero-title">Móda.<span>Naživo.</span></h1><div class="hero-actions"><a class="button" href={url('program/praha-glamour-2026/')}>Objevte CFW Glamour <span aria-hidden="true">↗</span></a><a class="text-link" href={url('archiv/')}>Vstoupit do archivu <span aria-hidden="true">↗</span></a></div></div>
      <div class="hero-bottom"><p class="hero-photo-credit">Z ARCHIVU CFW · BRNO 2024<br />Kolekce Jitka Klett</p><a class="scroll-cue" href="#pribeh">Příběh pokračuje <span aria-hidden="true">↓</span></a></div>
    </div>
  </section>
  <aside class="event-ribbon" aria-label="Nejbližší událost"><div class="container event-ribbon-inner"><div class="ribbon-date"><strong>20.11.</strong><span>2026<br />Pátek · 20:00</span></div><div class="ribbon-title"><strong>CFW Glamour · Praha</strong><p>PVA EXPO Praha, Letňany / Cocktail Chic</p></div><a class="text-link ribbon-link" href={url('program/praha-glamour-2026/')}>Program a vstupenky <span aria-hidden="true">↗</span></a></div></aside>
  <section class="section container" id="pribeh"><div class="intro-statement"><div class="reveal"><span class="number" aria-hidden="true">01</span><p class="eyebrow" style="margin-top:20px">Místo pro českou módu</p></div><div class="reveal"><h2>Na chvíli se zastavit.<br /><em>A nechat promluvit módu.</em></h2><div class="intro-sub"><p>Czech Fashion Week propojuje návrháře, výrazné osobnosti a publikum. V jedinečných místech vznikají přehlídky, setkání i příběhy, které pokračují za hranicí mola.</p><a class="text-link" href={url('o-cfw/')}>Příběh Czech Fashion Week <span aria-hidden="true">↗</span></a></div><div class="home-proof"><span>Česká tvorba</span><span>Výjimečná místa</span><span>Móda a pomoc</span></div></div></div></section>
  <section class="section container home-designers"><div class="section-heading reveal"><div><p class="eyebrow chapter">02 / Tvůrci a jejich rukopis</p><h2 class="section-title">Každá kolekce.<br />Jiný příběh.</h2></div><p class="section-intro">Večerní couture, pánská elegance i nové tvůrčí přístupy. Objevte návrháře prostřednictvím skutečných kolekcí z archivu CFW.</p></div><div class="designer-editorial">
    {[{image:laffita,name:'Osmany Laffita',slug:'osmany-laffita',text:'Výrazné siluety. Osobitá elegance.'},{image:klett,name:'Jitka Klett',slug:'jitka-klett',text:'Barva, pohyb a lehkost.'},{image:hanak,name:'Luděk Hanák',slug:'ludek-hanak',text:'Oděv jako výraz osobnosti.'}].map(item => item.image && <article class="reveal"><a href={url(`navrhari/${item.slug}/`)}><div class="image-frame"><img src={url(item.image.src)} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" /></div><h3>{item.name}</h3><p>{item.text}</p></a><a class="text-link" href={url(`navrhari/${item.slug}/`)}>Prohlédnout kolekce <span aria-hidden="true">↗</span></a></article>)}
  </div><div class="section-end"><a class="text-link" href={url('navrhari/')}>Všichni návrháři <span aria-hidden="true">↗</span></a></div></section>
  <section class="section archive-feature"><div class="container archive-feature-inner"><div class="archive-feature-copy reveal"><p class="eyebrow">03 / Archiv ročníků</p><h2>Móda má<br />paměť.</h2><p>Světlo před začátkem. První krok na mole. Detail, který zůstane. Vraťte se k okamžikům jednotlivých přehlídek.</p><a class="text-link" href={url('archiv/')}>Otevřít celý archiv <span aria-hidden="true">↗</span></a></div><div class="archive-feature-images"><div class="archive-year-links"><a class="archive-feature-year" href={url('archiv/2024/')}>2024</a><nav aria-label="Starší ročníky">{[2023,2022,2021,2020].map(year => <a href={url(`archiv/${year}/`)}>{year}</a>)}</nav></div><div class="archive-strip">{archiveImages.map(item => item && <a href={url(`media/${item.id}/`)}><img src={url(item.thumb)} alt={item.alt} width={item.width} height={item.height} loading="lazy" /></a>)}</div></div></div></section>
  <section class="section container"><div class="section-heading reveal"><div><p class="eyebrow chapter">04 / Móda v místech s příběhem</p><h2 class="section-title">Jedna platforma.<br />Různé perspektivy.</h2></div><p class="section-intro">Města a prostředí minulých ročníků dávají každé přehlídce vlastní atmosféru. Aktuální potvrzené události najdete v programu.</p></div><div class="places-grid">{[{name:'Praha',label:'Glamour / 20. 11. 2026',href:'program/praha-glamour-2026/',number:'01'},{name:'Brno',label:'Runway / archiv 2024',href:'archiv/?year=2024&city=Brno',number:'02'},{name:'Karlovy Vary',label:'Letní kapitola / archiv 2023',href:'archiv/?year=2023&city=Karlovy%20Vary',number:'03'},{name:'Teplice',label:'Tradice / archiv 2020–2023',href:'archiv/?city=Teplice',number:'04'}].map(place => <a class="place reveal" href={url(place.href)}><small>{place.number}</small><span class="place-arrow" aria-hidden="true">↗</span><h3>{place.name}</h3><p>{place.label}</p></a>)}</div></section>
  {runwayVideo && <section class="section container fashion-motion"><div class="motion-layout"><div class="reveal"><p class="eyebrow">05 / Zastavit obraz. Zachovat pohyb.</p><h2>Látka.<br />Světlo.<br /><span class="gold">Okamžik.</span></h2><p class="section-intro">Některé detaily potřebují pohyb. Krátké skutečné záznamy z Brna 2024 otevírají další pohled na kolekce.</p><a class="text-link" href={url('archiv/?type=video&year=2024')}>Videa z přehlídek <span aria-hidden="true">↗</span></a></div><div class="home-video reveal"><video id="runway-film" src={url(runwayVideo.src)} poster={url(runwayVideo.poster || runwayVideo.thumb)} muted loop playsinline preload="none" aria-label="Záznam z přehlídky Czech Fashion Week Brno 2024"></video><div class="home-video-controls"><button type="button" data-video-toggle="runway-film" aria-pressed="false">Přehrát film</button><span>Brno 2024 / Archiv CFW</span></div></div></div></section>}
  <section class="section container impact-section"><div class="editorial-grid"><figure class="reveal"><div class="impact-image">{backstage && <img src={url(backstage.src)} alt={backstage.alt} width={backstage.width} height={backstage.height} loading="lazy" />}<span class="impact-tag">Lidé a zákulisí / archiv CFW</span></div><figcaption class="image-caption">Každá přehlídka začíná spoluprací.</figcaption></figure><div class="editorial-copy reveal"><p class="eyebrow">06 / Móda a pomoc</p><h2 class="section-title">Krása, která<br />má přesah.</h2><p class="section-intro">Společenské setkání může pomáhat. Charitativní rozměr je součástí příběhu Czech Fashion Week.</p><p>Minulé ročníky spojily módu s podporou nemocnice v Teplicích, BJP Foundation i pomocí při povodních. Každý projekt má svůj konkrétní čas a příběh.</p><a class="text-link" href={url('o-cfw/#moda-a-pomoc')}>Poznat příběhy pomoci <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="container partner-invitation"><h2>Dejme dalším<br />příběhům prostor.</h2><div><p>Pro značky, místa a lidi, které spojuje vztah k tvorbě. Objevte možnosti spolupráce s Czech Fashion Week.</p><a class="text-link" href={url('partnerstvi/')}>Možnosti partnerství <span aria-hidden="true">↗</span></a></div></section>
</Layout>
