---
import Icon from '../components/Icon.astro';
import TicketLink from '../components/TicketLink.astro';
import Partners from '../components/Partners.astro';
import PersonalNote from '../components/PersonalNote.astro';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
import media from '../data/media.json';
import { designers } from '../data/designers';
import { events, primaryTicketEvent } from '../data/events';
import { officialPromoVideo } from '../data/official';
import '../styles/home.css';
const byOriginal = (name: string) => media.find(m => m.originalFilename.toLowerCase() === name.toLowerCase());
const hero = byOriginal('ZLY_8170.jpg') || media.find(m => m.year === 2024 && m.type === 'photo');
const klett = byOriginal('ZLY_8060.jpg') || hero;
const menswear = byOriginal('ZLY_7993.jpg') || hero;
const backstage = media.find(m => m.year === 2020 && m.tags?.includes('backstage') && m.type === 'photo') || media.find(m => m.year === 2020 && m.type === 'photo') || hero;
const runwayVideo = media.find(m => m.type === 'video' && m.year === 2024 && m.originalFilename.toLowerCase() === 'iveta.mov' && m.collection?.toLowerCase().includes('klett')) || media.find(m => m.type === 'video' && m.year === 2024);
const seasonEvents = events.filter(event => event.year === 2026);
const archiveImages = [klett, menswear, hero].filter(Boolean);
const heroEventDate = primaryTicketEvent?.date ? new Date(primaryTicketEvent.date) : undefined;
const heroEventDay = heroEventDate?.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', timeZone: 'Europe/Prague' }).replace(/\s/g, '');
const heroEventWeekday = heroEventDate?.toLocaleDateString('cs-CZ', { weekday: 'long', timeZone: 'Europe/Prague' });
---
<Layout title="Czech Fashion Week" description="Móda. Naživo. Objevte Czech Fashion Week, CFW Glamour Praha 20. listopadu 2026 a fotografický archiv českých přehlídek.">
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="home-hero-image" src={url(officialPromoVideo.poster)} alt={officialPromoVideo.alt} width={officialPromoVideo.posterWidth} height={officialPromoVideo.posterHeight} fetchpriority="high" loading="eager" />
    <video class="home-hero-video" id="hero-film" data-video-autoplay muted loop playsinline preload="metadata" width={officialPromoVideo.width} height={officialPromoVideo.height} aria-hidden="true" tabindex="-1" disablepictureinpicture><source media="(min-width: 761px)" src={url(officialPromoVideo.desktop)} type="video/mp4" /><source src={url(officialPromoVideo.mobile)} type="video/mp4" /></video>
    <div class="container hero-content">
      <div class="hero-top"><p class="eyebrow">Czech Fashion Week</p><p class="hero-edition">ČESKÁ MÓDA<br />V ŽIVÉM OBRAZE</p></div>
      <div class="hero-main"><div><h1 class="hero-headline" id="hero-title">Móda.<span>Naživo.</span></h1><div class="hero-actions"><TicketLink />{primaryTicketEvent && <a class="text-link" href={url(`program/${primaryTicketEvent.slug}/`)}>Objevte CFW Glamour <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>}</div>{primaryTicketEvent && <p class="hero-ticket-note">{primaryTicketEvent.city} · {primaryTicketEvent.dateLabel} · {primaryTicketEvent.ticketProvider}</p>}</div>
        {primaryTicketEvent && heroEventDay && <aside class="hero-next-event" aria-label="Příští událost"><p class="eyebrow">Nejbližší přehlídka</p><time datetime={primaryTicketEvent.date || undefined} aria-label={primaryTicketEvent.dateLabel}><span class="hero-next-date">{heroEventDay}</span><span class="hero-next-year">{primaryTicketEvent.year}</span></time><p class="hero-next-title">CFW Glamour · {primaryTicketEvent.city}</p><p class="hero-next-time">{heroEventWeekday} · {primaryTicketEvent.time}</p><p class="hero-next-venue">{primaryTicketEvent.venue}</p></aside>}
      </div>
      <div class="hero-bottom"><p class="hero-photo-credit">Czech Fashion Week<br />Móda v pohybu</p><div class="hero-bottom-actions"><a class="scroll-cue" href="#pribeh">Příběh pokračuje <span aria-hidden="true"><Icon name="arrow-down" /></span></a></div></div>
    </div>
  </section>
  <aside class="event-ribbon" aria-label="Nejbližší událost"><div class="container event-ribbon-inner"><div class="ribbon-date"><strong>20.11.</strong><span>2026<br />Pátek · 20:00</span></div><div class="ribbon-title"><strong>CFW Glamour · Praha</strong><p>PVA EXPO Praha, Letňany / Cocktail Chic</p></div><div class="ribbon-actions"><TicketLink class="text-link" /><a class="ribbon-detail" href={url(`program/${primaryTicketEvent?.slug || ''}/`)}>Program večera <Icon name="arrow-up-right" /></a></div></div></aside>
  <section class="section container" id="pribeh"><div class="intro-statement"><div class="reveal"><span class="number" aria-hidden="true">01</span><p class="eyebrow" style="margin-top:20px">Místo pro českou módu</p></div><div class="reveal"><h2>Na chvíli se zastavit.<br /><em>A nechat promluvit módu.</em></h2><div class="intro-sub"><p>Czech Fashion Week propojuje návrháře, výrazné osobnosti a publikum. V jedinečných místech vznikají přehlídky, setkání i příběhy, které pokračují za hranicí mola.</p><a class="text-link" href={url('o-cfw/')}>Příběh Czech Fashion Week <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><div class="home-proof"><span>Česká tvorba</span><span>Výjimečná místa</span><span>Móda a pomoc</span></div></div></div></section>
  <section class="section container home-designers"><div class="section-heading reveal"><div><p class="eyebrow chapter">02 / Tvůrci a jejich rukopis</p><h2 class="section-title">Každá kolekce.<br />Jiný příběh.</h2></div><p class="section-intro">Tváře a autorské rukopisy Czech Fashion Week. Poznejte návrháře a připomeňte si jejich kolekce v archivu.</p></div><div class="designer-editorial home-designer-grid">
    {designers.filter(designer => designer.listedOnOfficialSite).map(designer => designer.portrait && <article class="reveal"><a href={url(`navrhari/${designer.slug}/`)}><div class="image-frame"><img src={url(designer.portrait.src)} alt={designer.portrait.alt} width={designer.portrait.width} height={designer.portrait.height} loading="lazy" /></div><h3>{designer.name}</h3><p>{designer.category}</p></a><a class="text-link" href={url(`navrhari/${designer.slug}/`)}>Prohlédnout profil <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></article>)}
  </div><div class="section-end"><a class="text-link" href={url('navrhari/')}>Všichni návrháři a kolekce <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>
  <section class="section archive-feature"><div class="container archive-feature-inner"><div class="archive-feature-copy reveal"><p class="eyebrow">03 / Archiv ročníků</p><h2>Móda má<br />paměť.</h2><p>Světlo před začátkem. První krok na mole. Detail, který zůstane. Vraťte se k okamžikům jednotlivých přehlídek.</p><a class="text-link" href={url('archiv/')}>Otevřít celý archiv <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><div class="archive-feature-images"><div class="archive-year-links"><a class="archive-feature-year" href={url('archiv/2024/')}>2024</a><nav aria-label="Starší ročníky">{[2023,2022,2021,2020].map(year => <a href={url(`archiv/${year}/`)}>{year}</a>)}</nav></div><div class="archive-strip">{archiveImages.map(item => item && <a href={url(`media/${item.id}/`)}><img src={url(item.thumb)} alt={item.alt} width={item.width} height={item.height} loading="lazy" /></a>)}</div></div></div></section>
  <section class="section container"><div class="section-heading reveal"><div><p class="eyebrow chapter">04 / Události sezóny 2026</p><h2 class="section-title">Móda má<br />svá místa.</h2></div><p class="section-intro">Praha, Mariánské Lázně, Brno a Karlovy Vary. Každé město má vlastní atmosféru a příběh. Objevte program jednotlivých událostí.</p></div><div class="places-grid">{seasonEvents.map(event => <a class="place place--event reveal" href={url(`program/${event.slug}/`)}>{event.image && <div class="place-visual"><img src={url(event.image.src)} alt={event.image.alt} width={event.image.width} height={event.image.height} loading="lazy" /></div>}<small>{event.dateLabel}</small><span class="place-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span><h3>{event.city}</h3><p>{event.venue || event.title}</p></a>)}</div></section>
  {runwayVideo && <section class="section container fashion-motion"><div class="motion-layout"><div class="reveal"><p class="eyebrow">05 / Zastavit obraz. Zachovat pohyb.</p><h2>Látka.<br />Světlo.<br /><span class="gold">Okamžik.</span></h2><p class="section-intro">Některé detaily potřebují pohyb. Krátké skutečné záznamy z Brna 2024 otevírají další pohled na kolekce.</p><a class="text-link" href={url('archiv/?type=video&year=2024')}>Videa z přehlídek <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><div class="home-video reveal"><video id="runway-film" data-video-autoplay data-video-src={url(runwayVideo.src)} poster={url(runwayVideo.poster || runwayVideo.thumb)} muted loop playsinline preload="none" aria-label="Záznam z přehlídky Czech Fashion Week Brno 2024" disablepictureinpicture></video><div class="home-video-controls"><span class="video-note"><Icon name="volume-off" />Bez zvuku · Brno 2024</span></div></div></div></section>}
  <section class="section container impact-section"><div class="editorial-grid"><figure class="reveal"><div class="impact-image">{backstage && <img src={url(backstage.src)} alt={backstage.alt} width={backstage.width} height={backstage.height} loading="lazy" />}<span class="impact-tag">Lidé a zákulisí / archiv CFW</span></div><figcaption class="image-caption">Každá přehlídka začíná spoluprací.</figcaption></figure><div class="editorial-copy reveal"><p class="eyebrow">06 / Móda a pomoc</p><h2 class="section-title">Krása, která<br />má přesah.</h2><p class="section-intro">Společenské setkání může pomáhat. Charitativní rozměr je součástí příběhu Czech Fashion Week.</p><p>Minulé ročníky spojily módu s podporou nemocnice v Teplicích, BJP Foundation i pomocí při povodních. Každý projekt má svůj konkrétní čas a příběh.</p><a class="text-link" href={url('o-cfw/#moda-a-pomoc')}>Poznat příběhy pomoci <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div></section>
  <PersonalNote />
  <Partners compact />
  <section class="container partner-invitation"><h2>Dejme dalším<br />příběhům prostor.</h2><div><p>Pro značky, místa a lidi, které spojuje vztah k tvorbě. Objevte možnosti spolupráce s Czech Fashion Week.</p><a class="text-link" href={url('partnerstvi/')}>Možnosti partnerství <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>
</Layout>
