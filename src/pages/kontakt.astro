---
import Icon from '../components/Icon.astro';
import TicketLink from '../components/TicketLink.astro';
import { primaryTicketEvent } from '../data/events';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { url } from '../lib/paths';
import '../styles/content.css';
---
<Layout title="Kontakt" active="kontakt" description="Produkce, partnerství a média Czech Fashion Week. Spojte se s pořadatelem a připravte si e-mail přímo z webu.">
  <section class="section container contact-layout"><div class="contact-heading"><p class="eyebrow">Začíná to zprávou.</p><h1>Potkáme se<br />u dalšího příběhu.</h1><p class="section-intro">{site.contact.description}</p><form class="inquiry-form" id="inquiry-form"><div class="form-grid"><label>Vaše jméno<input name="name" autocomplete="name" required maxlength="100" /></label><label>Váš e-mail<input name="email" type="email" autocomplete="email" required maxlength="200" /></label><label class="form-wide">O čem si napíšeme<span class="icon-select"><select name="topic"><option>Program a účast</option><option>Partnerství</option><option>Média a fotografie</option><option>Spolupráce návrhářů</option><option>Jiný dotaz</option></select><Icon name="chevron-down" /><Icon name="chevron-up" /></span></label></div><label>Vaše zpráva<textarea name="message" required minlength="10" maxlength="5000" placeholder="Napište nám svou představu…"></textarea></label><p class="form-note">Tlačítko připraví zprávu ve vaší e-mailové aplikaci. Údaje se na tomto webu neukládají a zprávu odešlete až ve svém e-mailu.</p><button class="button button--dark" type="submit">Připravit e-mail <span aria-hidden="true"><Icon name="mail" /></span></button><p class="form-status" id="form-status" aria-live="polite"></p></form></div><aside class="contact-details"><div class="contact-detail"><h2>Produkce a média</h2><a class="icon-label" href={`mailto:${site.contact.email}`}><Icon name="mail" />{site.contact.email}</a><p style="margin-top:15px"><a class="icon-label" href={site.contact.phoneHref}><Icon name="phone" />{site.contact.phone}</a></p><button class="text-link" id="copy-email" type="button" style="border:0;border-bottom:1px solid var(--line);background:none;font-size:14px;margin-top:16px;padding-left:0"><span data-copy-label>Zkopírovat e-mail</span><span class="copy-state" aria-hidden="true"><Icon name="copy" /><Icon name="check" /></span></button><span id="copy-status" class="sr-only" aria-live="polite"></span></div><div class="contact-detail"><h2>Partnerství</h2><a class="icon-label" href={site.contact.partnerPhoneHref}><Icon name="phone" />{site.contact.partnerPhone}</a><p style="margin-top:12px"><a href={url('partnerstvi/')}>Možnosti spolupráce <Icon name="arrow-up-right" /></a></p></div><div class="contact-detail"><h2>Korespondenční adresa</h2><p class="icon-label"><Icon name="location" /><span>{site.contact.address}</span></p></div><div class="contact-detail"><h2>Aktuální program a vstupenky</h2>{primaryTicketEvent && <><p><a href={url(`program/${primaryTicketEvent.slug}/`)}>{primaryTicketEvent.title} / {primaryTicketEvent.dateLabel} <Icon name="arrow-up-right" /></a></p><div class="contact-purchase"><TicketLink class="text-link" /><p class="ticket-provider">Online prodej · {primaryTicketEvent.ticketProvider}</p></div></>}</div><p class="contact-official"><Icon name="info" />Kontakty ověřené podle <a href={site.contact.source} target="_blank" rel="noopener noreferrer">oficiálního webu pořadatele</a>.</p></aside></section>
</Layout>
<script>
 const form=document.querySelector<HTMLFormElement>('#inquiry-form');
 form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const subject=`Czech Fashion Week / ${data.get('topic')}`;const body=`${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;const link=document.createElement('a');link.href=`mailto:produkce@czechfashionweek.eu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;link.click();const status=document.querySelector('#form-status');if(status)status.textContent='Zpráva je připravená pro vaši e-mailovou aplikaci. Pokud se neotevřela, napište na produkce@czechfashionweek.eu.'});
 document.querySelector<HTMLButtonElement>('#copy-email')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText('produkce@czechfashionweek.eu');button.dataset.copied='true';const label=button.querySelector('[data-copy-label]');if(label)label.textContent='E-mail zkopírován';const status=document.querySelector('#copy-status');if(status)status.textContent='E-mail byl zkopírován do schránky.'}catch{const label=button.querySelector('[data-copy-label]');if(label)label.textContent='produkce@czechfashionweek.eu'}});
</script>
