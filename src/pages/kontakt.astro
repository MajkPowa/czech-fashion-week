---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { url } from '../lib/paths';
import '../styles/content.css';
---
<Layout title="Kontakt" active="kontakt" description="Produkce, partnerství a média Czech Fashion Week. Spojte se s pořadatelem a připravte si e-mail přímo z webu.">
  <section class="section container contact-layout"><div class="contact-heading"><p class="eyebrow">Začíná to zprávou.</p><h1>Potkáme se<br />u dalšího příběhu.</h1><p class="section-intro">{site.contact.description}</p><form class="inquiry-form" id="inquiry-form"><div class="form-grid"><label>Vaše jméno<input name="name" autocomplete="name" required maxlength="100" /></label><label>Váš e-mail<input name="email" type="email" autocomplete="email" required maxlength="200" /></label><label class="form-wide">O čem si napíšeme<select name="topic"><option>Program a účast</option><option>Partnerství</option><option>Média a fotografie</option><option>Spolupráce návrhářů</option><option>Jiný dotaz</option></select></label></div><label>Vaše zpráva<textarea name="message" required minlength="10" maxlength="5000" placeholder="Napište nám svou představu…"></textarea></label><p class="form-note">Tlačítko připraví zprávu ve vaší e-mailové aplikaci. Údaje se na tomto webu neukládají a zprávu odešlete až ve svém e-mailu.</p><button class="button button--dark" type="submit">Připravit e-mail <span aria-hidden="true">↗</span></button><p class="form-status" id="form-status" aria-live="polite"></p></form></div><aside class="contact-details"><div class="contact-detail"><h2>Produkce a média</h2><a href={`mailto:${site.contact.email}`}>{site.contact.email} ↗</a><p style="margin-top:15px"><a href={site.contact.phoneHref}>{site.contact.phone}</a></p><button class="text-link" id="copy-email" type="button" style="border:0;border-bottom:1px solid var(--line);background:none;font-size:10px;margin-top:16px;padding-left:0">Zkopírovat e-mail <span aria-hidden="true">↗</span></button><span id="copy-status" class="sr-only" aria-live="polite"></span></div><div class="contact-detail"><h2>Partnerství</h2><a href={site.contact.partnerPhoneHref}>{site.contact.partnerPhone}</a><p style="margin-top:12px"><a href={url('partnerstvi/')}>Možnosti spolupráce ↗</a></p></div><div class="contact-detail"><h2>Korespondenční adresa</h2><p>{site.contact.address}</p></div><div class="contact-detail"><h2>Aktuální program a vstupenky</h2><p><a href={url('program/praha-glamour-2026/')}>CFW Glamour Praha / 20. 11. 2026 ↗</a></p></div><p class="contact-official">Kontakty ověřené podle <a href={site.contact.source} target="_blank" rel="noopener noreferrer">oficiálního webu pořadatele</a>.</p></aside></section>
</Layout>
<script>
 const form=document.querySelector<HTMLFormElement>('#inquiry-form');
 form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const subject=`Czech Fashion Week / ${data.get('topic')}`;const body=`${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;const link=document.createElement('a');link.href=`mailto:produkce@czechfashionweek.eu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;link.click();const status=document.querySelector('#form-status');if(status)status.textContent='Zpráva je připravená pro vaši e-mailovou aplikaci. Pokud se neotevřela, napište na produkce@czechfashionweek.eu.'});
 document.querySelector<HTMLButtonElement>('#copy-email')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText('produkce@czechfashionweek.eu');button.textContent='E-mail zkopírován';const status=document.querySelector('#copy-status');if(status)status.textContent='E-mail byl zkopírován do schránky.'}catch{button.textContent='produkce@czechfashionweek.eu'}});
</script>
