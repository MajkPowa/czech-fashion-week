---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import media from '../data/media.json';
import { photoFor } from '../lib/content';
import { url } from '../lib/paths';
import '../styles/content.css';
const image=media.find(m=>m.originalFilename==='ZLY_7993.jpg')||photoFor(2024,'Brno');
---
<Layout title="Partnerství" active="partnerstvi" description={site.partnership.lead}>
  <section class="container partnership-hero"><div><p class="eyebrow">Pro značky, místa a lidi</p><h1>Vytvářejme<br />příběhy společně.</h1></div><p class="section-intro">{site.partnership.lead}</p></section>
  <figure class="container">{image&&<img class="partnership-image" src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="eager" />}<figcaption class="image-caption">Setkání tvorby a publika / Brno 2024</figcaption></figure>
  <section class="section container"><div class="section-heading reveal"><div><p class="eyebrow">Možnosti spolupráce</p><h2 class="section-title">Smysluplné spojení.<br />Vlastní podoba.</h2></div><p class="section-intro">{site.partnership.description}</p></div><div class="benefits">{site.partnership.benefits.map((benefit,index)=><article class="benefit reveal"><p class="benefit-number">0{index+1}</p><h3>{benefit.title}</h3><p>{benefit.description}</p></article>)}</div></section>
  <section class="container" style="padding-bottom:100px"><div class="contact-panel reveal"><p class="eyebrow" style="color:var(--gold);margin-bottom:25px">Další krok</p><h2>Řekněte nám<br />svou představu.</h2><p>Napište produkci, o které město či událost máte zájem a jakou podobu spolupráce hledáte. Konkrétní rozsah, dostupnost a podmínky vám představí pořadatel.</p><a class="text-link" href={`mailto:${site.email}?subject=${encodeURIComponent(site.partnership.emailSubject)}`}>{site.email} <span aria-hidden="true">↗</span></a><p style="margin-top:25px;margin-bottom:0"><a href={site.partnership.partnerPhoneHref}>Partnerství / {site.partnership.partnerPhone}</a></p></div></section>
</Layout>
