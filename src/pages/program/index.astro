---
import Icon from '../../components/Icon.astro';
import TicketLink from '../../components/TicketLink.astro';
import Layout from '../../layouts/Layout.astro';
import { upcomingEvents, completedEvents } from '../../data/events';
import { photoFor } from '../../lib/content';
import { url } from '../../lib/paths';
import '../../styles/content.css';
const next = upcomingEvents[0];
const image = next?.image || photoFor(2024,'Brno');
const seasonEvents = completedEvents.filter(event => event.year === 2026 && event.image);
const pastYears = [...new Set(completedEvents.map(event => event.year).filter((year): year is number => year !== null))].sort((a, b) => b - a);
---
<Layout title="Program" active="program" description="Aktuální potvrzený program Czech Fashion Week. CFW Glamour Praha 20. listopadu 2026 a přehled minulých událostí.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Setkání, která stojí za to.</p><h1>Uvidíme se<br />na přehlídce.</h1><p class="section-intro">Aktuální program a návraty k minulým událostem. Vyberte si svou další módní kapitolu.</p></div></section>
  {next && <section class="container section"><div class="program-feature reveal"><figure class="program-feature-image">{image && <img src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="eager" />}<figcaption>{next.image?.caption || 'Archiv Czech Fashion Week'}</figcaption></figure><div class="program-feature-copy"><p class="eyebrow">Nejbližší potvrzená událost</p><span class="tag">Praha / 2026</span><h2>CFW<br />Glamour.</h2><p class="program-date"><span class="icon-label"><Icon name="calendar" />20. listopadu</span><span class="icon-label"><Icon name="clock" />20:00</span></p><p class="icon-label" style="margin-top:15px"><Icon name="location" />{next.venue}</p><p style="margin-top:20px">{next.description}</p><div class="program-purchase"><TicketLink event={next} class="button button--light" /><p class="ticket-provider">Online prodej · {next.ticketProvider}</p><a class="text-link" href={url(`program/${next.slug}/`)}>Program večera <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div></div></section>}
  <section class="container section" style="padding-top:0" aria-labelledby="season-heading"><div class="section-heading"><div><p class="eyebrow">Sezóna 2026</p><h2 class="section-title" id="season-heading">Každá zastávka.<br />Vlastní tvář.</h2></div><p class="section-intro">Oficiální pozvánky jednotlivých měst. Zářijová, srpnová a červencová část sezóny již proběhla.</p></div><div class="event-season-grid">{seasonEvents.map(event => event.image && <article class="reveal"><a href={url(`program/${event.slug}/`)}><img src={url(event.image.src)} alt={event.image.alt} width={event.image.width} height={event.image.height} loading="lazy" /><p class="eyebrow">Proběhlo / {event.dateLabel}</p><h3>{event.city}</h3><p>{event.venue || 'Czech Fashion Week'}</p><span class="text-link">Detail události <Icon name="arrow-up-right" /></span></a></article>)}</div></section>
  <section class="container section" style="padding-top:0"><div class="section-heading"><div><p class="eyebrow">Minulé události</p><h2 class="section-title">Každé místo<br />má svůj příběh.</h2></div><p class="section-intro">Historický přehled a cesty k fotografiím. U archivních událostí zachováváme doložený rok a místo.</p></div>
    <div class="programme-filter" role="group" aria-label="Filtrovat minulé události"><button type="button" data-program-year="all" aria-pressed="true"><Icon name="filter" /> Všechny</button>{pastYears.map(year => <button type="button" data-program-year={year} aria-pressed="false">{year}</button>)}</div>
    <div class="event-list">{completedEvents.map(event => <a class="event-row" data-event-year={event.year} href={url(`program/${event.slug}/`)}><span class="event-year">{event.year}</span><h3>{event.city}</h3><p class="event-meta">{event.dateLabel}<br />{event.archiveYear ? 'Příběh a obrazový archiv' : 'Minulá událost sezóny'}</p><span class="row-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span></a>)}</div>
    <p class="source-note">Program ověřený 20. října 2026 podle <a href="https://cfw.cz/" target="_blank" rel="noopener noreferrer">oficiálního webu CFW</a>. Před návštěvou ověřte aktuální organizační pokyny.</p>
  </section>
</Layout>
<script>
 const buttons=document.querySelectorAll<HTMLButtonElement>('[data-program-year]');
 buttons.forEach(button=>button.addEventListener('click',()=>{const year=button.dataset.programYear;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-event-year]').forEach(row=>row.hidden=year!=='all'&&row.dataset.eventYear!==year);document.dispatchEvent(new CustomEvent('cfw:gallery-render'))}));
</script>
<style>
  .event-season-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
  .event-season-grid img{width:100%;height:auto;background:#fff}
  .event-season-grid .eyebrow{margin-top:22px;font-size:13px}
  .event-season-grid h3{font-size:28px;margin-block:12px}
  .event-season-grid article p:not(.eyebrow){font-size:16px;color:var(--muted)}
  .event-season-grid .text-link{margin-top:20px}
  @media(max-width:760px){.event-season-grid{grid-template-columns:1fr;gap:42px}.event-season-grid h3{font-size:28px}}
</style>
