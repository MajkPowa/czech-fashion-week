---
import Layout from '../../layouts/Layout.astro';
import { upcomingEvents, completedEvents } from '../../data/events';
import { photoFor } from '../../lib/content';
import { url } from '../../lib/paths';
import '../../styles/content.css';
const next = upcomingEvents[0];
const image = photoFor(2024,'Brno');
---
<Layout title="Program" active="program" description="Aktuální potvrzený program Czech Fashion Week. CFW Glamour Praha 20. listopadu 2026 a přehled minulých událostí.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Setkání, která stojí za to.</p><h1>Uvidíme se<br />na přehlídce.</h1><p class="section-intro">Aktuální program a návraty k minulým událostem. Vyberte si svou další módní kapitolu.</p></div></section>
  {next && <section class="container section"><div class="program-feature reveal"><figure class="program-feature-image">{image && <img src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="eager" />}<figcaption>Ilustrační archivní fotografie / Brno 2024</figcaption></figure><div class="program-feature-copy"><p class="eyebrow">Nejbližší potvrzená událost</p><span class="tag">Praha / 2026</span><h2>CFW<br />Glamour.</h2><p class="program-date">20. listopadu · 20:00</p><p style="margin-top:15px">{next.venue}</p><p style="margin-top:20px">{next.description}</p><a class="button button--light" href={url(`program/${next.slug}/`)}>Program a vstupenky <span aria-hidden="true">↗</span></a></div></div></section>}
  <section class="container section" style="padding-top:0"><div class="section-heading"><div><p class="eyebrow">Minulé události</p><h2 class="section-title">Každé místo<br />má svůj příběh.</h2></div><p class="section-intro">Historický přehled a cesty k fotografiím. U archivních událostí zachováváme doložený rok a místo.</p></div>
    <div class="programme-filter" role="group" aria-label="Filtrovat minulé události"><button type="button" data-program-year="all" aria-pressed="true">Všechny</button>{[2026,2024,2023,2022,2021,2020].map(year => <button type="button" data-program-year={year} aria-pressed="false">{year}</button>)}</div>
    <div class="event-list">{completedEvents.map(event => <a class="event-row" data-event-year={event.year} href={url(`program/${event.slug}/`)}><span class="event-year">{event.year}</span><h3>{event.city}</h3><p class="event-meta">{event.dateLabel}<br />{event.archiveYear ? 'Příběh a obrazový archiv' : 'Minulá událost sezóny'}</p><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div>
    <p class="source-note">Program ověřený 20. října 2026 podle <a href="https://cfw.cz/" target="_blank" rel="noopener noreferrer">oficiálního webu CFW</a>. Před návštěvou ověřte aktuální organizační pokyny.</p>
  </section>
</Layout>
<script>
 const buttons=document.querySelectorAll<HTMLButtonElement>('[data-program-year]');
 buttons.forEach(button=>button.addEventListener('click',()=>{const year=button.dataset.programYear;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-event-year]').forEach(row=>row.hidden=year!=='all'&&row.dataset.eventYear!==year)}));
</script>
