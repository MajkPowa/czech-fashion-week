---
import Layout from '../../layouts/Layout.astro';
import { events } from '../../data/events';
import { designers } from '../../data/designers';
import { photoFor } from '../../lib/content';
import { url } from '../../lib/paths';
import '../../styles/content.css';
export function getStaticPaths() { return events.map(event => ({ params: { slug: event.slug }, props: { event } })); }
const {event} = Astro.props;
const image = event.archiveYear ? photoFor(event.archiveYear,event.archiveCity) : undefined;
const related = designers.filter(designer => event.designers.includes(designer.slug));
const archiveHref = event.archiveYear ? `archiv/?year=${event.archiveYear}&city=${encodeURIComponent(event.archiveCity || event.city)}` : undefined;
const structured = event.status === 'confirmed' && event.date ? { '@context':'https://schema.org', '@type':'Event', name:event.title, startDate:event.date, eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',location:{'@type':'Place',name:event.venue,address:event.address},url:event.sourceUrl,description:event.description,organizer:{'@type':'Organization',name:'Czech Fashion Week',url:'https://cfw.cz/'} } : null;
---
<Layout title={`${event.city} · ${event.dateLabel}`} active="program" description={event.description}>
  {structured && <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured)} />}
  <section class="container event-detail-header"><nav class="breadcrumb" aria-label="Drobečková navigace"><a href={url()}>CFW</a><span>/</span><a href={url('program/')}>Program</a><span>/</span><span>{event.city}</span></nav><h1 class="event-detail-title">{event.title}</h1><div class="event-detail-meta"><span class="tag">{event.status === 'confirmed' ? 'Nadcházející událost' : 'Proběhlo / archiv'}</span><span>{event.dateLabel}</span>{event.time && <span>{event.time}</span>}{event.venue && <span>{event.venue}</span>}</div></section>
  {image && <figure class="container"><img class="event-cover" src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="eager" /><figcaption class="image-caption">{event.imageCaption || `${image.city} ${image.year} / Archiv CFW`}</figcaption></figure>}
  <section class="section container event-body"><div><section><p class="lead">{event.description}</p>{event.status === 'completed' && <p class="source-note">Tato stránka se věnuje historické události. Aktuální potvrzený program najdete v <a href={url('program/')}>přehledu událostí</a>.</p>}</section>
    {event.programme && <section><h2>Průběh večera</h2><ul class="event-schedule">{event.programme.map(item => <li><time>{item.time}</time><div><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}</div></li>)}</ul></section>}
    {event.practicalInfo && <section><h2>Před návštěvou</h2><ul class="practical-list">{event.practicalInfo.map(info => <li>{info}</li>)}</ul></section>}
    {related.length>0 && <section><h2>{event.status === 'completed' ? 'Návrháři v tomto ročníku' : 'Kolekce a tvorba'}</h2><div style="display:flex;flex-wrap:wrap;gap:18px">{related.map(designer => <a class="text-link" href={url(`navrhari/${designer.slug}/`)}>{designer.name}<span aria-hidden="true">↗</span></a>)}</div>{event.status==='confirmed' && <p class="source-note">Historické fotografie na profilech návrhářů jsou označené vlastním ročníkem.</p>}</section>}
    {event.sourceUrl && <p class="source-note">Podrobnosti a případné změny: <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer">oficiální informace pořadatele ↗</a></p>}
  </div><aside><dl class="event-facts"><div><dt>Místo</dt><dd>{event.venue || event.city}</dd></div><div><dt>{event.status === 'confirmed' ? 'Termín' : 'Ročník'}</dt><dd>{event.dateLabel}{event.time && ` / ${event.time}`}</dd></div>{event.address && <div><dt>Adresa</dt><dd>{event.address}</dd></div>}{event.dressCode && <div><dt>Dress code</dt><dd>{event.dressCode}</dd></div>}<div><dt>Produkce</dt><dd><a href="mailto:produkce@czechfashionweek.eu">produkce@czechfashionweek.eu</a></dd></div>
    {event.ticketUrl && <a class="button button--dark" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">Vstupenky · Ticketportal <span aria-hidden="true">↗</span></a>}
    {archiveHref && <a class="button" href={url(archiveHref)}>{event.status==='confirmed' ? 'Prohlédnout archiv CFW' : 'Otevřít galerii ročníku'} <span aria-hidden="true">↗</span></a>}
    </dl></aside></section>
</Layout>
