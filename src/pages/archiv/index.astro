---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
---
<Layout title="Archiv" description="Skutečné okamžiky Czech Fashion Week. Prozkoumejte fotografie a filmy z ročníků 2020–2024 podle místa, kolekce a roku." active="archiv">
  <div class="archive-page">
    <header class="archive-intro container">
      <div><p class="eyebrow">04 / ARCHIV CZECH FASHION WEEK</p><h1>Móda má<br /><em>paměť.</em></h1></div>
      <div class="archive-intro-aside"><span class="archive-date-range">2020—2024</span><p>Světla zhasnou. <br />Obrazy zůstávají.</p><p class="archive-intro-note">Přehlídky, kolekce i chvíle mezi nimi. Kurátorský výběr skutečných fotografií a filmů z archivu Czech Fashion Week.</p></div>
    </header>
    <div class="container"><Gallery /></div>
  </div>
</Layout>
