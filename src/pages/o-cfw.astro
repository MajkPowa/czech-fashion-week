---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { site, charityProjects, historyMilestones } from '../data/site';
import { photoFor } from '../lib/content';
import { url } from '../lib/paths';
import '../styles/content.css';
const image=photoFor(2023,'Karlovy Vary');
---
<Layout title="O Czech Fashion Week" active="o-cfw" description={site.about.lead}>
  <section class="page-hero"><div class="container"><p class="eyebrow">Móda · Lidé · Místa</p><h1>Prostor pro tvorbu.<br />Důvod se setkat.</h1><p class="section-intro">{site.about.lead}</p></div></section>
  <section class="section container about-lead"><figure>{image&&<img src={url(image.src)} alt={image.alt} width={image.width} height={image.height} loading="eager" />}<figcaption class="image-caption">Karlovy Vary 2023 / Archiv CFW</figcaption></figure><div class="content-body reveal"><p class="eyebrow">Česká móda v kontextu</p><h2>Každé místo.<br />Vlastní atmosféra.</h2>{site.about.paragraphs.map(paragraph=><p>{paragraph}</p>)}<a class="text-link" style="margin-top:30px" href={url('program/')}>Prozkoumat program <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>
  <section class="section container" style="padding-top:0"><div class="section-heading reveal"><div><p class="eyebrow">Příběh v obrazech</p><h2 class="section-title">Kapitoly,<br />ke kterým se vracíme.</h2></div><p class="section-intro">Pět let zachycených objektivem. Propojené vzpomínky na tvorbu, scénu a lidská setkání.</p></div><div class="history-list">{historyMilestones.map(milestone=><a class="history-item reveal" href={url(`archiv/${milestone.year}/`)}><span class="history-year">{milestone.year}</span><h3>{milestone.title}</h3><p>{milestone.description}<br /><span style="display:inline-block;margin-top:15px;color:var(--ink)">Otevřít ročník <Icon name="arrow-up-right" /></span></p></a>)}</div></section>
  <section class="section charity-section" id="moda-a-pomoc"><div class="container"><div class="section-heading reveal"><div><p class="eyebrow">Móda a pomoc</p><h2 class="section-title">Společně<br />má smysl víc.</h2></div><p class="section-intro">Kulturní zážitek může přinést i konkrétní pomoc. Připomínáme projekty z minulých ročníků.</p></div><div class="charity-grid">{charityProjects.map(project=><article class="charity-item reveal"><p class="charity-year">{project.year} / Historický projekt</p><h3>{project.title}</h3><p>{project.description}</p><p class="charity-beneficiary">Podpora: {project.beneficiary}</p></article>)}</div><p class="source-note">Historické projekty podle prezentace Czech Fashion Week 2025. Aktuální možnosti podpory konzultujte přímo s produkcí.</p><a class="text-link" style="margin-top:35px" href={url('kontakt/')}>Spojit se s pořadatelem <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>
</Layout>
