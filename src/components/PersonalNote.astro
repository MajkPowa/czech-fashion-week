---
import { personalNote } from '../data/official';
import { url } from '../lib/paths';
import '../styles/official.css';
---
<section class="section container personal-note" id="osobni-slovo" aria-labelledby="personal-note-title">
  <figure class="personal-note-portrait reveal"><img src={url(personalNote.portrait)} width={personalNote.width} height={personalNote.height} alt="Ing. Jiří Morštadt – Czech Fashion Week" loading="lazy" /><figcaption class="image-caption">Ing. Jiří Morštadt / Czech Fashion Week</figcaption></figure>
  <div class="personal-note-copy reveal"><p class="eyebrow">Czech Fashion Week</p><h2 id="personal-note-title">Úvodní slovo</h2>{personalNote.paragraphs.map(paragraph => <p>{paragraph}</p>)}<div class="personal-note-signature"><strong>{personalNote.name}</strong><span>Czech Fashion Week</span></div></div>
</section>
