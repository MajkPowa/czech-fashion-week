---
import '../styles/icons.css';

type IconName = 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'arrow-down' | 'arrow-up' | 'close' | 'play' | 'plus' | 'minus' | 'menu';
interface Props { name: IconName; class?: string; size?: number }
const { name, class: className, size } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-up-right': 'M4.5 19.5 19.5 4.5M9 4.5h10.5V15',
  'arrow-right': 'M3.5 12h17M13 4.5l7.5 7.5-7.5 7.5',
  'arrow-left': 'M20.5 12h-17M11 4.5 3.5 12l7.5 7.5',
  'arrow-down': 'M12 3.5v17M4.5 13l7.5 7.5 7.5-7.5',
  'arrow-up': 'M12 20.5v-17M4.5 11 12 3.5l7.5 7.5',
  close: 'M5.5 5.5l13 13M18.5 5.5l-13 13',
  play: 'M7.5 4.5 19 12 7.5 19.5Z',
  plus: 'M12 3.5v17M3.5 12h17',
  minus: 'M3.5 12h17',
  menu: 'M3.5 8h17M3.5 16h17',
};
---
<svg class:list={['cf-icon', `cf-icon--${name}`, className]} xmlns="http://www.w3.org/2000/svg" width={size || 24} height={size || 24} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true" focusable="false" style={size ? `--icon-size:${size}px` : undefined}>
  <path d={paths[name]} vector-effect="non-scaling-stroke" />
</svg>
