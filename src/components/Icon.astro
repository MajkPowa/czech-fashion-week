---
import '../styles/icons.css';
import { iconPaths, type IconName } from '../lib/iconography';
interface Props { name: IconName; class?: string; size?: number }
const { name, class: className, size } = Astro.props;
---
<svg class:list={['cf-icon', `cf-icon--${name}`, className]} xmlns="http://www.w3.org/2000/svg" width={size || 24} height={size || 24} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false" style={size ? `--icon-size:${size}px` : undefined}>
  <path d={iconPaths[name]} vector-effect="non-scaling-stroke" />
</svg>
