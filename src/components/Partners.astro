---
import { officialMainPartners, officialSupportingPartners, mainPartners, supportingPartners, patronages, realisationPartners2024, realisationPanels2024 } from '../data/partners';
import { url } from '../lib/paths';
import Icon from './Icon.astro';
import '../styles/partners.css';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const groups = [
  { id: 'oficialni-hlavni-partneri', label: 'Hlavní partneři akcí', items: officialMainPartners, type: 'official-main' },
  { id: 'oficialni-dalsi-partneri', label: 'Partneři akcí', items: officialSupportingPartners, type: 'official-supporting' },
];
const historicalGroups = [
  { id: 'hlavni-partneri', label: 'Hlavní partneři předchozích ročníků', items: mainPartners, type: 'main' },
  { id: 'dalsi-partneri', label: 'Další partneři předchozích ročníků', items: supportingPartners, type: 'supporting' },
  { id: 'partneri-2024', label: 'Partneři v realizacích roku 2024', items: realisationPartners2024, type: 'realisation' },
  { id: 'zastity', label: 'Záštity předchozích ročníků', items: patronages, type: 'patronage' },
];
---
<section class:list={['section', 'partners-section', compact && 'partners-section--compact']} id="partneri" aria-labelledby="partners-heading">
  <div class="container">
    <header class="partners-heading reveal">
      <div><p class="eyebrow">Síla spolupráce</p><h2 id="partners-heading">Za módou stojí<br /><em>silná spojení.</em></h2></div>
      <p>Děkujeme partnerům, kteří s námi vytvářejí Czech Fashion Week. Jejich podpora propojuje módu, kulturu a osobní setkávání.</p>
    </header>
    {groups.map((group, index) => <div class:list={['partner-group', `partner-group--${group.type}`]} aria-labelledby={group.id}>
      <div class="partner-group-heading"><h3 id={group.id}>{group.label}</h3><span aria-hidden="true">0{index + 1} / {String(group.items.length).padStart(2, '0')}</span></div>
      <div class="partner-grid">
        {group.items.map(partner => <figure class="partner-logo-card partner-logo-card--dark" data-partner={partner.id}>
          <a class="partner-logo-link" href={partner.website} target="_blank" rel="noopener noreferrer" aria-label={`${partner.name} — oficiální web`}>
            <div class="partner-logo-image"><img src={url(partner.logo)} alt={partner.alt} width={partner.width} height={partner.height} loading="lazy" decoding="async" /></div>
          </a>
          <figcaption>{partner.name}</figcaption>
        </figure>)}
      </div>
    </div>)}
    <p class="partner-source-note">Přehled partnerů akcí Czech Fashion Week. Partnerství se může lišit podle konkrétní události.</p>
    <details class="partner-history">
      <summary><span>Partneři a záštity předchozích ročníků</span><span class="partner-panels-toggle" aria-hidden="true"><Icon name="plus" /><Icon name="minus" /></span></summary>
      <div class="partner-history-content">
        <p class="partner-source-note">Partneři a záštity předchozích ročníků: 35 partnerských značek a 8 záštit. Historické partnerské panely připomínají realizace z roku 2024.</p>
        {historicalGroups.map((group, index) => <div class:list={['partner-group', `partner-group--${group.type}`]} aria-labelledby={group.id}>
          <div class="partner-group-heading"><h3 id={group.id}>{group.label}</h3><span aria-hidden="true">0{index + 1} / {String(group.items.length).padStart(2, '0')}</span></div>
          <div class="partner-grid">
            {group.items.map(partner => <figure class:list={['partner-logo-card', partner.tone === 'dark' && 'partner-logo-card--dark']} data-partner={partner.id}>
              <div class="partner-logo-image"><img src={url(partner.logo)} alt={partner.alt} width={partner.width} height={partner.height} loading="lazy" decoding="async" /></div>
              <figcaption>{partner.identification === 'unidentified-monogram' ? 'Partnerský monogram' : partner.name}</figcaption>
            </figure>)}
          </div>
          {group.type === 'realisation' && <details class="partner-panels">
            <summary><span>Úplné partnerské panely z roku 2024</span><span class="partner-panels-toggle" aria-hidden="true"><Icon name="plus" /><Icon name="minus" /></span></summary>
            <div class="partner-panels-content"><p>Původní podoba partnerských panelů z historických realizací Czech Fashion Week.</p>{realisationPanels2024.map(panel => <a class="partner-panel-link" href={url(panel.src)} target="_blank" rel="noopener noreferrer"><figure><img src={url(panel.src)} alt={panel.alt} width={panel.width} height={panel.height} loading="lazy" decoding="async" /><figcaption>Zvětšit partnerský panel <Icon name="arrow-up-right" /></figcaption></figure></a>)}</div>
          </details>}
        </div>)}
      </div>
    </details>
    {compact && <div class="partners-more"><p>Česká móda vzniká díky společné energii.</p><a class="text-link" href={url('partnerstvi/#partneri')}>Partneři a spolupráce <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.partner-history, .partner-panels').forEach(panel => {
    panel.addEventListener('toggle', () => document.dispatchEvent(new CustomEvent('cfw:gallery-render')));
  });
</script>
